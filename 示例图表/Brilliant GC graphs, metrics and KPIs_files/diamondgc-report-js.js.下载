function commonPositionTitleContainer(dataType, sectionId, chartInstance){
	// Accept chart as optional parameter for better encapsulation
	// Falls back to global 'chart' variable (from window scope) for backward compatibility
	var chart = chartInstance || (typeof window !== 'undefined' && window.chart ? window.chart : null);

	var top = "";
	var left = "";

	if($('#linkContainer').length != 0) {

 		$("#graphLink").removeAttr("data-type");
 		$("#graphLink").attr("data-type", dataType);
 		if (chart && chart.title && chart.title.bounds) {
 			top = (chart.title.bounds.y2 / 2) - 15;
 			left = chart.title.bounds.x2 + 20;
	 		$("#linkContainer").css({top: top, left: left});
 		}
 		// Always show the link container when this function is called
 		$("#linkContainer").css({display: "block"});
	}

	if($('#' + sectionId).length != 0) {

 		top = ($('#chartContainer-' + dataType).position().top) + 2;
 		if (chart && chart.title && chart.title.bounds) {
 			left = chart.title.bounds.x2 + 50;
 		} else {
 			// Fallback if chart bounds not available
 			left = 0;
 		}
		$("#" + sectionId).css({top: top, left: left});
 		$("#" + sectionId).css({display: "block"});
	}
}