// --------------------------------------------------------
//	Navigation Bar
// --------------------------------------------------------
$(window).scroll(function(){
	"use strict";
	
	var scroll = $(window).scrollTop();
	
	if (typeof path !== 'undefined') {
	
		if( scroll > 60 ){
			$(".navbar").addClass("scroll-fixed-navbar");
			$("#fastthread-new-logo").attr("src",path+"assets/yc-images/fastthread-new-logo.svg");
			$("#gceasy-new-logo").attr("src",path+"assets/yc-images/gceasy-new-logo.svg");
	
		} else if(window.innerWidth < 767 ){
			$("#gceasy-new-logo").attr("src",path+"assets/yc-images/gceasy-new-logo.svg");
			$("#fastthread-new-logo").attr("src",path+"assets/yc-images/fastthread-new-logo.svg");
		} else {
			$(".navbar").removeClass("scroll-fixed-navbar");
			$("#fastthread-new-logo").attr("src",path+"assets/fastthread/images/ft-white-new-logo.svg");
			$("#gceasy-new-logo").attr("src",path+"assets/yc-images/gc-white-new-logo.svg");
		}	
	}
});

