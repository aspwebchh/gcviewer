/*
 * This function will be invoked when user click on resend link
 * */
function resend() {
	
	try {
		
		var email = $('#resend-link').text();
		
		$.ajax({
	        type : "POST",
	        url : "./resend-verification",
	        data: {
	        	"emailid": encodeTxt(email),
				'a': encodeTxt(appName),
		 	},
			success : function(response) {
	        	let id = null;
	        	let dataAttr = $("#signin-verification-link-sent").attr("data-resend-from");
	        	
				// Issue : After signing up, when user click on 'Send Again' link, resent message is not displayed on the page. 
				// Instead that message is displayed on Sign in popup.
				// Fix: When signin modal is opened appending custom attribute(data-resend-from) to the div to differentiate 
				// resend message is coming from signIn or signup page (Code is present in main.js)
				// Now checking if the div id and custom attribute is present then response is coming from signIn popup
				// else response is from signUp page. 
	        	if($("#signin-verification-link-sent").length !== 0 && (dataAttr)) {
	        		
	        		id = "signin-verification-link-sent";
	        	} else if($("#verification-link-sent").length !== 0) {
	        		
	        		id = "verification-link-sent";
	        	}

	        	if(response.status) {
	        		
	        		// Append message
	        		$("#" + id).html(response.message);
	        		
	        	} else {
	        		
	        		$("#" + id).html(response.message);
	        	}
	        },
	        error: function(err) {
	        	
	        	console.log("Failed to resend verification link");
	        	
	        	// Display error message on the page
	        	
	        }
	 	});
	} catch(e) {
		
		console.log("Failed to resend verification link - " + e);
		
		// Display error message on the page
	}
}