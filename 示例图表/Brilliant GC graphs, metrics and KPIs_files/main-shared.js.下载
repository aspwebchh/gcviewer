    var toast;

    var {duration = 3000, type = "successful", appendTo = "body"} = options;

    toast = $('<div class="toast toast-' + type + '">' +
        '<div class="toast-message">' +
        '<h6 class="toast-heading">' + heading + '</h6>' +
        '<p class="toast-text">' + message + '</p> ' +
