// Function to close passed popup
function closePopup(popup) {
    var afterCloseFunction = popup.data('afterClose');
    popup.addClass('hidden').removeClass('active-popup');
    if (typeof afterCloseFunction === 'function') {
        setTimeout(() => {
            afterCloseFunction();
