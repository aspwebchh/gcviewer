                        checkedRadio = $(this)
                    }
                    if ($(this).prop('checked') === true) {
                        propCheckedRadio = $(this)
                    }
                })
                if (!propCheckedRadio) {
                    checkedRadio.prop('checked', true)
                }
            })
        }
    })
    refreshGlobalError($('#' + multiFormContainer.attr('data-notification-container')), 'nMGlobalMultiForm')
}

