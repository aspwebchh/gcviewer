// File size converter
function formatBytesSI(bytes) {
    var units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
    var i = 0;
    while (bytes >= 1000 && i < units.length - 1) {
        bytes = bytes / 1000;
        i++;
    }
    return (i === 0 ? bytes : bytes.toFixed(2)) + ' ' + units[i];
}

