                    // Show error
                    showNotification(modalSignIn.find('.options-line'), response.message, {
                        id: 'nMGlobal',
                        type: 'box',
                        hasIcon: true
                    });
                }

                // End submitting
                formSubmitSet(modalSignInForm, 'end', modalSignIn)
            },
            error: function (err) {
                // Show error
